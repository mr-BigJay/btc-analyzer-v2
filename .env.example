# CoinEx AI Research (futures page → AI Research tab)
# https://www.coinex.com/en/futures/btc-usdt
COINEX_ENABLED=true
COINEX_BASE_URL=https://www.coinex.com
COINEX_AI_COIN=btc
COINEX_FUTURES_PAGE_URL=https://www.coinex.com/en/futures/btc-usdt
COINEX_ANALYSIS_PATH=/res/ai-analysis/btc

# Binance Futures (market reference) — keys optional for public data
BINANCE_FUTURES_ENABLED=true
BINANCE_SYMBOL=BTCUSDT
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Deribit Options — secrets via env only (Ch.3 §3.18)
DERIBIT_ENABLED=true
DERIBIT_CURRENCY=BTC
DERIBIT_CLIENT_ID=
DERIBIT_CLIENT_SECRET=
DERIBIT_BASE_URL=https://www.deribit.com/api/v2

# Bitunix execution validation — never primary analytical source
BITUNIX_ENABLED=false
BITUNIX_API_KEY=
BITUNIX_API_SECRET=
BITUNIX_BASE_URL=https://fapi.bitunix.com

# Persistence (Ch.4) — PostgreSQL recommended for production
# DATABASE_URL=postgresql+psycopg://btc:btc@localhost:5432/btc_analyzer
DATABASE_URL=sqlite:///./data/btc_analyzer.db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Redis cache (optional — memory fallback if empty)
REDIS_URL=
REDIS_HOT_TTL_SEC=300

# Scheduler (Ch.3 §3.14)
DAILY_OUTLOOK_HOUR_UTC=3
DAILY_OUTLOOK_MINUTE_UTC=30
COLLECTION_INTERVAL_MINUTES=1

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# API
API_HOST=0.0.0.0
API_PORT=8000
