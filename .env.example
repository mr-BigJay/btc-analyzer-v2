# Exchange: auto | binance | okx
EXCHANGE_PROVIDER=auto

# Binance (public endpoints — no API key required for market data)
SYMBOL=BTCUSDT
FUTURES_SYMBOL=BTCUSDT

# Database
DATABASE_URL=sqlite:///./data/btc_analyzer.db

# Collection
KLINES_LIMIT=500
COLLECTION_INTERVAL_MINUTES=15

# Telegram (phase 3)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_THRESHOLD=70
DAILY_REPORT_HOUR=8

# API / Dashboard
API_HOST=0.0.0.0
API_PORT=8000

# CoinEx Futures (supplementary derivatives research)
COINEX_ENABLED=true
COINEX_MARKET=BTCUSDT
COINEX_AI_ENABLED=true
COINEX_AI_ASSET=btc
COINEX_AI_LANG=en_US
DERIBIT_CLIENT_ID=
DERIBIT_CLIENT_SECRET=
DERIBIT_CURRENCY=BTC
